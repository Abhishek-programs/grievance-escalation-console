{
    "name": "grievance-escalation-console",
    "private": true,
    "type": "module",
    "scripts": {
        "dev:server": "node --watch server/src/server.ts",
        "dev:web": "vite --config web/vite.config.ts",
        "test": "node --test server/tests/*.test.ts",
        "migrate": "node server/scripts/migrate.ts",
        "generate:data": "node server/scripts/generate-data.ts",
        "build": "vite build --config web/vite.config.ts",
        "ci": "npm test && npm run build"
    },
    "engines": {
        "node": ">=24.22.0"
    },
    "dependencies": {
        "@neon/config": "^1.9.2",
        "@neon/env": "^1.6.3",
        "@radix-ui/react-checkbox": "^1.4.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-tabs": "^1.2.1",
        "@tailwindcss/vite": "^4.3.3",
        "@vercel/functions": "^3.10.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "csv-parse": "7.0.3",
        "express": "5.3.0",
        "lucide-react": "^1.60.0",
        "pg": "8.23.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.5",
        "@types/pg": "^8.23.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "typescript": "7.0.2",
        "vite": "8.3.4"
    }
}
