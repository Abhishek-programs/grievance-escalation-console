{
    "name": "grievance-escalation-console",
    "private": true,
    "type": "module",
    "scripts": {
        "dev:server": "node --watch server/src/server.ts",
        "test": "node --test server/tests/*.test.ts",
        "migrate": "node server/src/migrate.ts",
        "generate:data": "node server/src/generate-data.ts",
        "ci": "npm test && npm run build"
    },
    "engines": {
        "node": ">=24.22.0"
    },
    "dependencies": {
        "csv-parse": "7.0.3",
        "express": "5.3.0",
        "pg": "8.23.1",
        "react": "19.3.1",
        "react-dom": "19.3.1"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.5",
        "@types/pg": "^8.23.1",
        "typescript": "7.0.2",
        "vite": "8.3.4"
    }
}
